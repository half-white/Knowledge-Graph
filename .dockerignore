# ---- 版本控制 / 编辑器 ----
.git
.gitignore
# 仅排除 defspec 需求文档；docs/swagger 生成物是编译必需（SSE/docs/swagger 导入），须进构建上下文
docs/defspec/
.vscode/
.DS_Store

# ---- 依赖快照（不入库；镜像构建统一经 go mod download 拉取，保证与 CI 一致） ----
vendor/

# ---- 本地构建产物（不应进镜像） ----
SSE
SSE.exe
*.exe
output.txt

# ---- 运行期数据 ----
logs/

# 本地运行配置（可能含密钥，容器内配置一律由 compose 环境变量注入；
# 入库模板 config.example.yml 不受影响，可进镜像）
config/config.yml

# ---- 前端依赖/产物（后端镜像构建时不需要 node_modules 进上下文） ----
**/node_modules
frontend/dist

# ---- 部署辅助 ----
deploy/jenkins/jenkins_home/
