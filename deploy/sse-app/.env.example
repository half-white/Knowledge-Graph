# ============================================================
# SSE 应用栈环境变量样例
# 复制为 .env 后按需修改： cp .env.example .env
# .env 不入库；未设置的项全部有安全默认值（本地沙箱可直接 up）
# ============================================================

# 宿主机日志目录：容器日志文件挂载位置，Promtail 由此采集。
# 默认指向“仓库根/logs”（相对本文件所在 deploy/sse-app 的 ../../logs）。
# 若希望后端日志留在别处，改成绝对路径，例如：
# SSE_LOG_HOST_DIR=/Users/xieenping/work/Knowledge-Graph/logs

# 镜像 tag（滚动部署建议按版本/提交号设置）
# SSE_IMAGE_TAG=latest

# ---- 数据库（默认 = 本地容器 neo4j/kg-mysql 发布在宿主端口）----
# SSE_NEO4J_URI=bolt://host.docker.internal:7687
# SSE_NEO4J_USER=neo4j
# SSE_NEO4J_PASSWORD=neo4j
# SSE_MYSQL_DSN=root:root@tcp(host.docker.internal:3306)/knowledge_graph?charset=utf8mb4&parseTime=True&loc=Local

# ---- 日志级别 ----
# SSE_LOG_LEVEL=info

# ---- 大模型 / 检索密钥（按需填写）----
# GLM_API_KEY=
# BAIDU_CLIENT_ID=
# BAIDU_CLIENT_SECRET=
# RAG_THRESHOLD=
# RAG_TOP_K=
