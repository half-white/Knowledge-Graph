# 忽略 docs/ 目录内容（DefSpec 全部文件：模板、指令、需求文档、规格），
# 放行 docs/swagger/（swag 生成的接口文档，REQ-007，入库供 CI/他人离线编译）
docs/*
!docs/swagger/

# 编译产物
SSE.exe
SSE

# Go 依赖快照不入库（vendor 仅本地离线开发用）：
# 依赖事实源为 go.mod/go.sum，CI 与镜像构建经 go mod download 拉取
# （GOPROXY=https://goproxy.cn,direct，与 Dockerfile/Jenkinsfile 保持一致）
vendor/

# 日志输出目录（由 logger 包按天生成，Promtail 采集）
logs/

# 由 Windows 绝对路径误创建的残留目录
C:/

# macOS
.DS_Store

# 编辑器本地配置（调试配置保留在本地，不入库）
/.vscode/

# 本地项目配置（config.example.yml 为入库模板；config.yml 含运行配置/密钥，不入库）
config/config.yml

# 部署密钥与环境变量（.env.example 模板入库，.env 真实值不入库）
.env
**/.env

# Jenkins 数据卷（若落在工作区内，含账号/凭据，绝不入库）
deploy/jenkins/jenkins_home/

# ./.cursor/ 目录
/.cursor/

# Go 调试器（Delve）生成的临时调试二进制
__debug_bin*
